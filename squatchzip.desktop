[Desktop Entry]
Version=1.0
Type=Application
Name=SquatchZip
GenericName=Archive Manager
Comment=Modern 7-Zip GUI for openSUSE Tumbleweed — with Delete After Archiving
Exec=squatchzip %f
Icon=squatchzip
MimeType=application/x-7z-compressed;application/zip;application/x-tar;application/gzip;application/x-bzip2;application/x-xz;application/x-compressed-tar;application/x-bzip-compressed-tar;application/x-xz-compressed-tar;application/vnd.rar;application/x-iso9660-image;application/vnd.ms-cab-compressed;application/x-ms-wim;
Categories=Utility;Archiving;Compression;
Keywords=archive;zip;7z;tar;compress;extract;pack;unpack;
Terminal=false
StartupNotify=true
StartupWMClass=squatchzip
